# 构建环境（云构建沙箱）连接 registry.npmjs.org 不稳定，常出现 ECONNRESET。
# 切换到国内可达的 npmmirror 镜像，并加大重试/超时，避免 npm install 被重置导致镜像构建失败。
# 若你的构建环境无法访问 npmmirror，可改为腾讯云镜像：
#   registry=https://mirrors.cloud.tencent.com/npm/
# 若只能访问官方源，则删除下面这行 registry，仅保留重试/超时配置。
registry=https://registry.npmmirror.com/

fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=180000
fetch-timeout=600000
maxsockets=10
audit=false
fund=false
